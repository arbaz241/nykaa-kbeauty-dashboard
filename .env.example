# Copy to .env and fill in real values. Never commit .env.

# Supabase (Phase 3) — from Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# Scraper uses the service role key (server-side writes, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard uses the anon key (client-side, respects RLS + Auth)
SUPABASE_ANON_KEY=

# Scraper behaviour
SCRAPE_TOP_N=100            # products captured per subcategory
SCRAPE_MIN_DELAY_SEC=2      # polite delay between requests (min)
SCRAPE_MAX_DELAY_SEC=5      # polite delay between requests (max)
LOG_LEVEL=INFO

# Copy to .env and fill in real values. Never commit .env.

# Supabase (Phase 3) — from Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# Scraper uses the service role key (server-side writes, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard uses the anon key (client-side, respects RLS + Auth)
SUPABASE_ANON_KEY=

# Scraper behaviour — see scraper/config.py for all knobs and defaults.
# Enrichment volume: ENRICH_MAX_RATING_COUNT=300, ENRICH_REFRESH_DAYS=7,
# ENRICH_MAX_PRODUCTS_PER_RUN=80. Scheduled runs set SCRAPE_START_JITTER_SEC=1800.
SCRAPE_TOP_N=100            # products captured per subcategory
SCRAPE_MIN_DELAY_SEC=2      # polite delay between requests (min)
SCRAPE_MAX_DELAY_SEC=5      # polite delay between requests (max)
LOG_LEVEL=INFO
SCRAPE_WEB_FALLBACK=0     # 1 = re-scrape a category from website pages if the app API fails (web ranking)

# Dashboard (Phase 5). Supabase > Project Settings > Database > Connection string
# (Session pooler, IPv4). Local dev can point at any Postgres with the schema applied.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Dashboard auth (Phase 6): the anon key above + DASHBOARD_AUTH_DISABLED=1 only for local dev.
DASHBOARD_AUTH_DISABLED=0
